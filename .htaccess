# Project-root fallback for XAMPP/shared hosting where the document root is the
# project folder instead of /public. On correctly configured hosts, point the
# document root directly at /public and this file is ignored.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose source, configuration, logs, uploads or tooling. Requests for
    # these paths must not fall through to the front controller.
    RewriteRule ^(?:app|bin|bootstrap|config|core|database|deploy|docker|docs|lib|mcp|resources|routes|scripts|storage|tests|vendor)(?:/|$) - [F,L,NC]

    # Forward all other requests into the public directory.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes

# Prevent direct browsing of application source and dotfiles.
<FilesMatch "\.(env|md|json|lock|sql|log|ini|conf|dist|bak|old|swp)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
