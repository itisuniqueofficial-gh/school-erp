# ==========================================================================
# School ERP - Environment Configuration
# Copy this file to `.env` and adjust values for your environment.
# ==========================================================================

# Application
APP_NAME="School ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=
APP_BASE_PATH=
APP_KEY=
APP_MAINTENANCE=false
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Database. Engines: mysql, mariadb, pgsql (PostgreSQL).
# Either fill the DB_* values or set ONE connection URL (it wins over DB_*):
#   DATABASE_URL=mysql://user:p%40ssword@127.0.0.1:3306/school_erp
#   DATABASE_URL=postgres://user:password@db.example.com:5432/school_erp?sslmode=require
# Percent-encode special characters in the password (@ = %40, : = %3A, / = %2F).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_erp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Optional: DB_SOCKET=/var/run/mysqld/mysqld.sock   DB_TIMEOUT=10   DB_SCHEMA=public (PostgreSQL)
# Optional: DB_SSL_MODE=disable|prefer|require|verify-ca|verify-full  DB_SSL_CA=/path/ca.pem  DB_SSL_CERT=  DB_SSL_KEY=

# File storage. Keep uploads OUTSIDE the web root on cPanel / VPS:
# STORAGE_PATH=/home/youruser/erp-storage
# Object storage (AWS S3, Cloudflare R2, MinIO...): FILESYSTEM_DISK=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   (R2: S3_REGION=auto)
# S3_REGION=us-east-1  S3_BUCKET=  S3_KEY=  S3_SECRET=  S3_PATH_STYLE=true  S3_PREFIX=erp
DB_COLLATION=utf8mb4_unicode_ci
# For SQLite use absolute/path to file or ':memory:'
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# DB_PORT=0

# SSL/TLS (optional for managed DBs)
DB_SSL=false
DB_SSL_CA=
DB_SSL_VERIFY=true

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Security
CSRF_TOKEN_NAME=_token
BCRYPT_COST=12
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@schoolerp.test
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway (pluggable)
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=

# Payment Gateway (pluggable)
PAYMENT_DRIVER=offline
PAYMENT_KEY=
PAYMENT_SECRET=

# File Storage
UPLOAD_MAX_SIZE=5242880
FILESYSTEM_DISK=local

# API
API_TOKEN_TTL=3600
API_RATE_LIMIT=100
