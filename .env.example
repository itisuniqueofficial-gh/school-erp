# ==========================================================================
# School ERP - Environment Configuration
# Copy this file to `.env` and adjust values for your environment.
# ==========================================================================

# Application
APP_NAME="School ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=
APP_MAINTENANCE=false
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_erp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Security
CSRF_TOKEN_NAME=_token
BCRYPT_COST=12
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@schoolerp.test
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway (pluggable)
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=

# Payment Gateway (pluggable)
PAYMENT_DRIVER=offline
PAYMENT_KEY=
PAYMENT_SECRET=

# File Storage
UPLOAD_MAX_SIZE=5242880
UPLOAD_DISK=local

# API
API_TOKEN_TTL=3600
API_RATE_LIMIT=100
