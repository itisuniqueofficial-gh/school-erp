#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * ===========================================================================
 * School ERP - Console
 * ---------------------------------------------------------------------------
 * Usage:
 *   php bin/console migrate          Run pending migrations
 *   php bin/console migrate:fresh    Drop all tables and re-run migrations
 *   php bin/console migrate:status   Show migration status
 *   php bin/console seed             Seed baseline data
 *   php bin/console key:generate     Generate & write APP_KEY into .env
 *   php bin/console backup           Dump the database to storage/backups
 * ===========================================================================
 */

use Core\Config\Config;
use Core\Database\Connection;
use Database\Migrator;
use Database\Seeds\DatabaseSeeder;

$root = dirname(__DIR__);

/** @var \Core\Application $app */
$app = require $root . '/bootstrap/app.php';

$command = $argv[1] ?? 'help';

/** Small colored output helpers. */
$out = static function (string $msg, string $color = ''): void {
    $colors = ['green' => "\033[32m", 'red' => "\033[31m", 'yellow' => "\033[33m", 'cyan' => "\033[36m"];
    $reset = "\033[0m";
    $prefix = $colors[$color] ?? '';
    echo $prefix . $msg . ($prefix ? $reset : '') . PHP_EOL;
};

try {
    switch ($command) {
        case 'migrate':
            $ran = (new Migrator())->migrate();
            if ($ran === []) {
                $out('Nothing to migrate. Database is up to date.', 'yellow');
            } else {
                foreach ($ran as $m) {
                    $out("Migrated: {$m}", 'green');
                }
            }
            break;

        case 'migrate:fresh':
            // Guard: migrate:fresh DROPS ALL TABLES. Never allow it to run in a
            // production environment by accident — require an explicit --force.
            if (config('app.env') === 'production' && !in_array('--force', $argv, true)) {
                $out('REFUSED: migrate:fresh drops all tables and would destroy production data.', 'red');
                $out('This is a destructive operation and APP_ENV=production.', 'yellow');
                $out('Use "php bin/console migrate" for safe additive upgrades, or', 'yellow');
                $out('re-run with --force if you are absolutely certain.', 'yellow');
                exit(1);
            }
            $out('Dropping all tables...', 'yellow');
            $migrator = new Migrator();
            $migrator->fresh();
            $ran = $migrator->migrate();
            foreach ($ran as $m) {
                $out("Migrated: {$m}", 'green');
            }
            $out('Fresh migration complete.', 'green');
            break;

        case 'migrate:status':
            $status = (new Migrator())->status();
            $out('Applied migrations:', 'cyan');
            foreach ($status['applied'] as $m) {
                $out("  [x] {$m}");
            }
            $out('Pending migrations:', 'cyan');
            foreach ($status['pending'] as $m) {
                $out("  [ ] {$m}", 'yellow');
            }
            if ($status['pending'] === []) {
                $out('  (none)', 'green');
            }
            break;

        case 'upgrade':
            // Zero-data-loss production upgrade: back up first, then apply ONLY
            // pending (additive) migrations. Never drops/truncates/seeds.
            $out('=== Safe Upgrade ===', 'cyan');
            $ping = \Core\Database\Connection::instance()->ping();
            if (!$ping['ok']) {
                $out('Database not reachable — aborting upgrade (no changes made).', 'red');
                exit(1);
            }
            $status = (new Migrator())->status();
            if ($status['pending'] === []) {
                $out('Already up to date (' . count($status['applied']) . ' migrations). Nothing to do.', 'green');
                break;
            }
            $out(count($status['pending']) . ' pending migration(s). Creating a safety backup first...', 'yellow');
            $backup = (new \App\Services\BackupService())->create();
            if ($backup !== null) {
                $out("Backup written to: {$backup}", 'green');
            } else {
                $out('WARNING: automatic backup failed (mysqldump missing?). Continuing — migrations are additive and non-destructive.', 'yellow');
            }
            try {
                $ran = (new Migrator())->migrate();
                foreach ($ran as $m) {
                    $out("Migrated: {$m}", 'green');
                }
                $out('Upgrade complete. ' . count($ran) . ' migration(s) applied; existing data preserved.', 'green');
            } catch (\Throwable $e) {
                $out('Migration FAILED: ' . $e->getMessage(), 'red');
                if ($backup !== null) {
                    $out("Restore the pre-upgrade backup with: php bin/console — or via Admin > Backups ({$backup})", 'yellow');
                }
                exit(1);
            }
            break;

        case 'health':
            $out('=== School ERP Health Check ===', 'cyan');
            $healthFail = 0;
            $pass = static function (string $m) use ($out): void { $out('  [PASS] ' . $m, 'green'); };
            $fail = static function (string $m) use ($out, &$healthFail): void { $out('  [FAIL] ' . $m, 'red'); $healthFail++; };
            $warn = static function (string $m) use ($out): void { $out('  [WARN] ' . $m, 'yellow'); };

            // 1. Database connection
            $ping = \Core\Database\Connection::instance()->ping();
            $ping['ok'] ? $pass('Database connection') : $fail('Database connection: ' . $ping['error']);

            // 2. Database schema (required tables present)
            if ($ping['ok']) {
                $required = ['users', 'roles', 'permissions', 'user_roles', 'students', 'staff',
                    'academic_years', 'classes', 'sections', 'subjects', 'class_subjects',
                    'teacher_assignments', 'student_attendance', 'subject_attendance', 'exams',
                    'audit_logs', 'notifications', 'login_attempts'];
                $rows = \Core\Database\Connection::instance()->select(
                    'SELECT table_name AS t FROM information_schema.tables WHERE table_schema = DATABASE()'
                );
                $have = array_map(static fn ($r) => strtolower((string) ($r['t'] ?? $r['T'] ?? '')), $rows);
                $missing = array_values(array_diff($required, $have));
                $missing === [] ? $pass('Database schema (' . count($required) . ' core tables)') : $fail('Missing tables: ' . implode(', ', $missing));

                // Key unique constraints for data integrity.
                $uniq = \Core\Database\Connection::instance()->scalar(
                    "SELECT COUNT(*) FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = 'subject_attendance' AND index_name = 'uq_subject_attendance'"
                );
                (int) $uniq > 0 ? $pass('Attendance duplicate-prevention constraint') : $warn('uq_subject_attendance constraint not found');
            }

            // 3. Migrations
            try {
                $status = (new Migrator())->status();
                $status['pending'] === [] ? $pass('Migrations up to date (' . count($status['applied']) . ' applied)') : $warn(count($status['pending']) . ' pending migration(s) — run: php bin/console migrate');
            } catch (\Throwable $e) {
                $fail('Migration status: ' . $e->getMessage());
            }

            // 4. Storage writability
            foreach (['storage/logs', 'storage/cache', 'storage/sessions', 'storage/uploads', 'storage/uploads/avatars'] as $dir) {
                is_writable($root . '/' . $dir) ? $pass('Writable: ' . $dir) : $fail('Not writable: ' . $dir);
            }

            // 5. Environment configuration
            (string) config('app.key', '') !== '' ? $pass('APP_KEY is set') : $fail('APP_KEY is empty — run: php bin/console key:generate');
            if (config('app.env') === 'production' && (bool) config('app.debug', false) === true) {
                $fail('APP_DEBUG is true in production — set APP_DEBUG=false');
            } else {
                $pass('Debug mode appropriate for environment (' . config('app.env') . ')');
            }

            $out('', '');
            if ($healthFail === 0) {
                $out('All health checks passed. System is ready.', 'green');
            } else {
                $out("{$healthFail} check(s) failed. See above.", 'red');
                exit(1);
            }
            break;

        case 'seed':
            $out('Seeding database...', 'cyan');
            (new DatabaseSeeder())->run();
            $out('Seeding complete.', 'green');
            $out('Default login: superadmin@school.test / Password123!', 'yellow');
            break;

        case 'key:generate':
            $key = bin2hex(random_bytes(16));
            $envFile = $root . '/.env';
            if (!is_file($envFile)) {
                copy($root . '/.env.example', $envFile);
            }
            $contents = (string) file_get_contents($envFile);
            if (preg_match('/^APP_KEY=.*$/m', $contents)) {
                $contents = preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, $contents) ?? $contents;
            } else {
                $contents .= "\nAPP_KEY={$key}\n";
            }
            file_put_contents($envFile, $contents);
            $out('Application key set successfully.', 'green');
            break;

        case 'backup':
            $out('Running database backup...', 'cyan');
            $file = (new \App\Services\BackupService())->create();
            if ($file !== null) {
                $out("Backup written to: {$file}", 'green');
            } else {
                $out('Backup failed. Ensure mysqldump is installed and credentials are correct.', 'red');
            }
            break;

        case 'reminders':
            $out('Generating reminders...', 'cyan');
            $counts = (new \App\Services\ReminderService())->run();
            foreach ($counts as $type => $n) {
                $out("  {$type}: {$n}", 'green');
            }
            $out('Reminders generated.', 'green');
            break;

        case 'cleanup:logs':
            $n = (new \App\Services\BackupService())->cleanupLogs((int) ($argv[2] ?? 30));
            $out("Removed {$n} old log file(s).", 'green');
            break;

        case 'cleanup:sessions':
            $n = (new \App\Services\BackupService())->cleanupSessions();
            $out("Removed {$n} expired session file(s).", 'green');
            break;

        case 'install':
            // Non-interactive install: migrate + seed (for CLI/CI provisioning).
            $out('Running migrations...', 'cyan');
            (new Migrator())->migrate();
            $out('Seeding baseline data...', 'cyan');
            (new DatabaseSeeder())->run();
            $out('Installation complete. Default login: superadmin@school.test / Password123!', 'green');
            break;

        case 'help':
        default:
            $out('School ERP Console', 'cyan');
            $out('Available commands:');
            $out('  migrate            Run pending migrations');
            $out('  migrate:fresh      Drop all tables and re-run migrations');
            $out('  migrate:status     Show migration status');
            $out('  seed               Seed baseline data');
            $out('  health             Run a full system health check');
            $out('  upgrade            Safe production upgrade: backup + pending migrations only');
            $out('  install            Migrate + seed in one step');
            $out('  key:generate       Generate & write APP_KEY into .env');
            $out('  backup             Dump the database to storage/backups');
            $out('  reminders          Generate birthday/fee/exam/holiday reminders');
            $out('  cleanup:logs [days] Delete log files older than N days (default 30)');
            $out('  cleanup:sessions   Delete expired session files');
            break;
    }
} catch (\Throwable $e) {
    $out('Error: ' . $e->getMessage(), 'red');
    if ((bool) Config::get('app.debug')) {
        $out($e->getFile() . ':' . $e->getLine());
        $out($e->getTraceAsString());
    }
    exit(1);
}

exit(0);
