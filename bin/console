#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * ===========================================================================
 * School ERP - Console
 * ---------------------------------------------------------------------------
 * Usage:
 *   php bin/console migrate          Run pending migrations
 *   php bin/console migrate:fresh    Drop all tables and re-run migrations
 *   php bin/console migrate:status   Show migration status
 *   php bin/console seed             Seed baseline data
 *   php bin/console key:generate     Generate & write APP_KEY into .env
 *   php bin/console backup           Dump the database to storage/backups
 * ===========================================================================
 */

use Core\Config\Config;
use Core\Database\Connection;
use Database\Migrator;
use Database\Seeds\DatabaseSeeder;

$root = dirname(__DIR__);

/** @var \Core\Application $app */
$app = require $root . '/bootstrap/app.php';

$command = $argv[1] ?? 'help';

/** Small colored output helpers. */
$out = static function (string $msg, string $color = ''): void {
    $colors = ['green' => "\033[32m", 'red' => "\033[31m", 'yellow' => "\033[33m", 'cyan' => "\033[36m"];
    $reset = "\033[0m";
    $prefix = $colors[$color] ?? '';
    echo $prefix . $msg . ($prefix ? $reset : '') . PHP_EOL;
};

/** Read --name=value / --name from the raw argv array. */
$option = static function (string $name) use ($argv): ?string {
    foreach ($argv as $arg) {
        if ($arg === '--' . $name) {
            return '';
        }
        if (str_starts_with($arg, '--' . $name . '=')) {
            return substr($arg, strlen($name) + 3);
        }
    }
    return null;
};

$flag = static function (string $name) use ($argv): bool {
    return in_array('--' . $name, $argv, true);
};

/** Read a secret from the terminal without echoing it when possible. */
$readHidden = static function (string $prompt): string {
    $isTty = function_exists('posix_isatty') && defined('STDIN') && @posix_isatty(STDIN);
    if (!$isTty) {
        fwrite(STDOUT, $prompt);
        return trim((string) fgets(STDIN));
    }

    $saved = @shell_exec('stty -g 2>/dev/null');
    if (is_string($saved) && trim($saved) !== '') {
        @shell_exec('stty -echo 2>/dev/null');
        fwrite(STDOUT, $prompt);
        $value = trim((string) fgets(STDIN));
        fwrite(STDOUT, PHP_EOL);
        @shell_exec('stty ' . escapeshellarg(trim($saved)) . ' 2>/dev/null');
        return $value;
    }

    fwrite(STDOUT, $prompt);
    return trim((string) fgets(STDIN));
};

try {
    switch ($command) {
        case 'migrate':
            $ran = (new Migrator())->migrate();
            if ($ran === []) {
                $out('Nothing to migrate. Database is up to date.', 'yellow');
            } else {
                foreach ($ran as $m) {
                    $out("Migrated: {$m}", 'green');
                }
            }
            break;

        case 'migrate:fresh':
            // Guard: migrate:fresh DROPS ALL TABLES. Refuse when it would destroy
            // real data — production env, OR a populated non-"_test" database in a
            // non-disposable (local/dev) environment — unless --force is given.
            // CI and other test contexts (APP_ENV=testing, CI=true, APP_TESTING=1)
            // rebuild a throwaway database every run, so they are allowed.
            $force = in_array('--force', $argv, true);
            $dbName = (string) config('database.connections.' . config('database.default') . '.database');
            $isTestDb = str_ends_with($dbName, '_test');
            $env = (string) config('app.env');
            $disposable = getenv('APP_TESTING') === '1'
                || $env === 'testing'
                || filter_var((string) getenv('CI'), FILTER_VALIDATE_BOOLEAN);
            $hasData = false;
            try { $hasData = (int) (\Core\Database\Connection::instance()->selectOne('SELECT COUNT(*) AS c FROM `users`')['c'] ?? 0) > 0; } catch (\Throwable) {}
            if (!$force && ($env === 'production' || (!$isTestDb && $hasData && !$disposable))) {
                $out('REFUSED: migrate:fresh drops ALL tables and would destroy existing data.', 'red');
                $out("Target database: '{$dbName}'" . ($hasData ? ' (contains records)' : '') . '.', 'yellow');
                $out('For tests use a dedicated DB: APP_TESTING=1 php bin/console migrate:fresh', 'yellow');
                $out('For safe upgrades use: php bin/console migrate   (additive, non-destructive)', 'yellow');
                $out('Re-run with --force only if you are absolutely certain.', 'yellow');
                exit(1);
            }
            $out('Dropping all tables...', 'yellow');
            $migrator = new Migrator();
            $migrator->fresh();
            $ran = $migrator->migrate();
            foreach ($ran as $m) {
                $out("Migrated: {$m}", 'green');
            }
            $out('Fresh migration complete.', 'green');
            break;

        case 'migrate:status':
            $status = (new Migrator())->status();
            $out('Applied migrations:', 'cyan');
            foreach ($status['applied'] as $m) {
                $out("  [x] {$m}");
            }
            $out('Pending migrations:', 'cyan');
            foreach ($status['pending'] as $m) {
                $out("  [ ] {$m}", 'yellow');
            }
            if ($status['pending'] === []) {
                $out('  (none)', 'green');
            }
            break;

        case 'upgrade':
            // Zero-data-loss production upgrade: back up first, then apply ONLY
            // pending (additive) migrations. Never drops/truncates/seeds.
            $out('=== Safe Upgrade ===', 'cyan');
            $ping = \Core\Database\Connection::instance()->ping();
            if (!$ping['ok']) {
                $out('Database not reachable — aborting upgrade (no changes made).', 'red');
                exit(1);
            }
            $status = (new Migrator())->status();
            if ($status['pending'] === []) {
                $out('Already up to date (' . count($status['applied']) . ' migrations). Nothing to do.', 'green');
                break;
            }
            $out(count($status['pending']) . ' pending migration(s). Creating a safety backup first...', 'yellow');
            $backup = (new \App\Services\BackupService())->create();
            if ($backup !== null) {
                $out("Backup written to: {$backup}", 'green');
            } else {
                $out('WARNING: automatic backup failed (mysqldump missing?). Continuing — migrations are additive and non-destructive.', 'yellow');
            }
            try {
                $ran = (new Migrator())->migrate();
                foreach ($ran as $m) {
                    $out("Migrated: {$m}", 'green');
                }
                $out('Upgrade complete. ' . count($ran) . ' migration(s) applied; existing data preserved.', 'green');
            } catch (\Throwable $e) {
                $out('Migration FAILED: ' . $e->getMessage(), 'red');
                if ($backup !== null) {
                    $out("Restore the pre-upgrade backup with: php bin/console — or via Admin > Backups ({$backup})", 'yellow');
                }
                exit(1);
            }
            break;

        case 'health':
            $out('=== School ERP Health Check ===', 'cyan');
            $healthFail = 0;
            $pass = static function (string $m) use ($out): void { $out('  [PASS] ' . $m, 'green'); };
            $fail = static function (string $m) use ($out, &$healthFail): void { $out('  [FAIL] ' . $m, 'red'); $healthFail++; };
            $warn = static function (string $m) use ($out): void { $out('  [WARN] ' . $m, 'yellow'); };

            // 1. Database connection
            $ping = \Core\Database\Connection::instance()->ping();
            $ping['ok'] ? $pass('Database connection') : $fail('Database connection: ' . $ping['error']);

            // 2. Database schema (required tables present)
            if ($ping['ok']) {
                $required = ['users', 'roles', 'permissions', 'user_roles', 'students', 'staff',
                    'academic_years', 'classes', 'sections', 'subjects', 'class_subjects',
                    'teacher_assignments', 'student_attendance', 'subject_attendance', 'exams',
                    'audit_logs', 'notifications', 'login_attempts'];
                $rows = \Core\Database\Connection::instance()->select(
                    'SELECT table_name AS t FROM information_schema.tables WHERE table_schema = DATABASE()'
                );
                $have = array_map(static fn ($r) => strtolower((string) ($r['t'] ?? $r['T'] ?? '')), $rows);
                $missing = array_values(array_diff($required, $have));
                $missing === [] ? $pass('Database schema (' . count($required) . ' core tables)') : $fail('Missing tables: ' . implode(', ', $missing));

                // Key unique constraints for data integrity.
                $uniq = \Core\Database\Connection::instance()->scalar(
                    "SELECT COUNT(*) FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = 'subject_attendance' AND index_name = 'uq_subject_attendance'"
                );
                (int) $uniq > 0 ? $pass('Attendance duplicate-prevention constraint') : $warn('uq_subject_attendance constraint not found');
            }

            // 3. Migrations
            try {
                $status = (new Migrator())->status();
                $status['pending'] === [] ? $pass('Migrations up to date (' . count($status['applied']) . ' applied)') : $warn(count($status['pending']) . ' pending migration(s) — run: php bin/console migrate');
            } catch (\Throwable $e) {
                $fail('Migration status: ' . $e->getMessage());
            }

            // 4. Storage writability
            foreach (['storage/logs', 'storage/cache', 'storage/sessions', 'storage/uploads', 'storage/uploads/avatars'] as $dir) {
                is_writable($root . '/' . $dir) ? $pass('Writable: ' . $dir) : $fail('Not writable: ' . $dir);
            }

            // 5. Environment configuration
            (string) config('app.key', '') !== '' ? $pass('APP_KEY is set') : $fail('APP_KEY is empty — run: php bin/console key:generate');
            if (config('app.env') === 'production' && (bool) config('app.debug', false) === true) {
                $fail('APP_DEBUG is true in production — set APP_DEBUG=false');
            } else {
                $pass('Debug mode appropriate for environment (' . config('app.env') . ')');
            }

            $out('', '');
            if ($healthFail === 0) {
                $out('All health checks passed. System is ready.', 'green');
            } else {
                $out("{$healthFail} check(s) failed. See above.", 'red');
                exit(1);
            }
            break;

        case 'seed':
            $out('Seeding database...', 'cyan');
            (new DatabaseSeeder())->run();
            $out('Seeding complete.', 'green');
            $out('Default login: superadmin@school.test / Password123!', 'yellow');
            break;

        case 'key:generate':
            $key = bin2hex(random_bytes(16));
            $envFile = $root . '/.env';
            if (!is_file($envFile)) {
                copy($root . '/.env.example', $envFile);
            }
            $contents = (string) file_get_contents($envFile);
            if (preg_match('/^APP_KEY=.*$/m', $contents)) {
                $contents = preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, $contents) ?? $contents;
            } else {
                $contents .= "\nAPP_KEY={$key}\n";
            }
            file_put_contents($envFile, $contents);
            $out('Application key set successfully.', 'green');
            break;

        case 'db:check':
            // Detect-only database integrity audit (never deletes/repairs).
            $out('Running database integrity audit...', 'cyan');
            $checks = (new \App\Services\IntegrityService())->checks();
            $issues = 0; $critical = 0;
            foreach ($checks as $c) {
                $n = (int) ($c['count'] ?? 0);
                $sev = (string) ($c['severity'] ?? 'info');
                if ($n > 0) {
                    $issues++;
                    if ($sev === 'critical') { $critical++; }
                    $out(sprintf('  [%s] %s: %d  -> %s', strtoupper($sev), (string) $c['label'], $n, (string) ($c['link'] ?? '')), $sev === 'critical' ? 'red' : 'yellow');
                } else {
                    $out(sprintf('  [OK] %s', (string) $c['label']), 'green');
                }
            }
            $out(sprintf('Audit complete: %d check(s), %d with issues (%d critical).', count($checks), $issues, $critical), $critical > 0 ? 'red' : ($issues > 0 ? 'yellow' : 'green'));
            $out('This audit is read-only. Review each item at the linked admin page; nothing was changed.', 'cyan');
            exit($critical > 0 ? 1 : 0);

        case 'db:preflight':
            // Read-only connectivity diagnostic. NEVER prints the password.
            $line = static function (string $label, string $status, string $color) use ($out): void {
                $out(sprintf('  %-14s %s', $label . ':', $status), $color);
            };
            $out('Database preflight', 'cyan');
            $host = (string) config('database.connections.mysql.host');
            $dbName = (string) config('database.connections.mysql.database');
            $user = (string) config('database.connections.mysql.username');
            $hasPass = ((string) config('database.connections.mysql.password')) !== '';
            $line('Environment', PHP_VERSION_ID >= 80300 ? 'OK (PHP ' . PHP_VERSION . ')' : 'CHECK PHP VERSION', PHP_VERSION_ID >= 80300 ? 'green' : 'yellow');
            $cfgOk = $host !== '' && $dbName !== '' && $user !== '';
            $line('Configuration', $cfgOk ? 'OK' : 'INCOMPLETE (set DB_HOST / DB_DATABASE / DB_USERNAME)', $cfgOk ? 'green' : 'yellow');
            $out(sprintf('    host=%s port=%s database=%s user=%s password=%s',
                $host !== '' ? $host : '(unset)',
                (string) config('database.connections.mysql.port'),
                $dbName !== '' ? $dbName : '(unset)',
                $user !== '' ? $user : '(unset)',
                $hasPass ? '(set)' : '(empty)'), 'cyan');
            $p = \Core\Database\DatabasePreflight::probe();
            $line('MySQL server', $p['ok'] ? 'OK' : \Core\Database\DatabasePreflight::label($p['state']), $p['ok'] ? 'green' : 'red');
            if (!$p['ok']) {
                $out('    ' . $p['message'], 'red');
            }
            if ($p['ok']) {
                $hasSchema = false;
                try { \Core\Database\Connection::instance()->pdo()->query('SELECT 1 FROM users LIMIT 1'); $hasSchema = true; } catch (\Throwable) {}
                $line('Schema', $hasSchema ? 'OK' : 'MIGRATIONS REQUIRED', $hasSchema ? 'green' : 'yellow');
            } else {
                $line('Schema', 'UNKNOWN', 'yellow');
            }
            $ready = $p['ok'] && $cfgOk;
            $out('Overall: ' . ($ready ? 'READY' : 'NOT READY'), $ready ? 'green' : 'red');
            exit($ready ? 0 : 1);

        case 'backup':
            $out('Running database backup...', 'cyan');
            $svc = new \App\Services\BackupService();
            $file = $svc->create();
            if ($file !== null) {
                $out("Backup written to: {$file}", 'green');
                $v = $svc->verify(basename($file));
                $out(($v['ok'] ? 'VERIFIED: ' : 'WARNING: ') . $v['message'], $v['ok'] ? 'green' : 'red');
                if (!$v['ok']) {
                    exit(1);
                }
            } else {
                $out('Backup failed. Ensure mysqldump is installed and credentials are correct.', 'red');
                exit(1);
            }
            break;

        case 'backup:verify':
            $target = $argv[2] ?? '';
            if ($target === '') {
                $out('Usage: php bin/console backup:verify <filename.sql>', 'yellow');
                $list = (new \App\Services\BackupService())->list();
                if ($list !== []) {
                    $out('Available backups:', 'cyan');
                    foreach ($list as $b) { $out('  ' . $b['name'] . ' (' . number_format($b['size']) . ' bytes)'); }
                }
                exit(1);
            }
            $v = (new \App\Services\BackupService())->verify($target);
            $out(($v['ok'] ? 'VERIFIED: ' : 'INVALID: ') . $v['message'], $v['ok'] ? 'green' : 'red');
            exit($v['ok'] ? 0 : 1);

        case 'restore':
            // Restore OVERWRITES the target database. Verify the dump first, and
            // refuse to overwrite a populated non-"_test" DB unless --force.
            $target = $argv[2] ?? '';
            $force = in_array('--force', $argv, true);
            if ($target === '') {
                $out('Usage: php bin/console restore <filename.sql> [--force]', 'yellow');
                exit(1);
            }
            $svc = new \App\Services\BackupService();
            $v = $svc->verify($target);
            if (!$v['ok']) {
                $out('REFUSED: backup did not pass verification — ' . $v['message'], 'red');
                exit(1);
            }
            $dbName = (string) config('database.connections.' . config('database.default') . '.database');
            $isTestDb = str_ends_with($dbName, '_test');
            $hasData = false;
            try { $hasData = (int) (\Core\Database\Connection::instance()->selectOne('SELECT COUNT(*) AS c FROM `users`')['c'] ?? 0) > 0; } catch (\Throwable) {}
            if (!$force && (config('app.env') === 'production' || (!$isTestDb && $hasData))) {
                $out('REFUSED: restore OVERWRITES all data in the target database.', 'red');
                $out("Target database: '{$dbName}'" . ($hasData ? ' (contains records)' : '') . '.', 'yellow');
                $out('Take a fresh backup first, then re-run with --force if you are certain.', 'yellow');
                exit(1);
            }
            $out("Restoring '{$target}' into '{$dbName}'...", 'cyan');
            if ($svc->restore($target)) {
                $out('Restore complete. Verify with: php bin/console health', 'green');
            } else {
                $out('Restore failed. Ensure the mysql client is installed and credentials are correct.', 'red');
                exit(1);
            }
            break;

        case 'reminders':
            $out('Generating reminders...', 'cyan');
            $counts = (new \App\Services\ReminderService())->run();
            foreach ($counts as $type => $n) {
                $out("  {$type}: {$n}", 'green');
            }
            $out('Reminders generated.', 'green');
            break;

        case 'cleanup:logs':
            $n = (new \App\Services\BackupService())->cleanupLogs((int) ($argv[2] ?? 30));
            $out("Removed {$n} old log file(s).", 'green');
            break;

        case 'cleanup:sessions':
            $n = (new \App\Services\BackupService())->cleanupSessions();
            $out("Removed {$n} expired session file(s).", 'green');
            break;

        case 'snapshot':
            $svc = new \App\Services\MigrationSnapshotService();
            $file = $svc->save();
            $snap = $svc->load($file);
            $out('Migration snapshot written: ' . $file, 'green');
            $out('  DB: ' . ($snap['database'] ?? '?') . ' (' . ($snap['driver'] ?? '?') . ')  env: ' . ($snap['environment'] ?? '?'), 'cyan');
            $out('  Total records: ' . ($snap['total_records'] ?? 0) . '   Migrations applied: ' . ($snap['migrations_applied'] ?? 0), 'cyan');
            break;

        case 'snapshot:compare':
            $path = $argv[2] ?? '';
            $svc = new \App\Services\MigrationSnapshotService();
            $before = $path !== '' ? $svc->load($path) : null;
            if ($before === null) {
                $out('Usage: php bin/console snapshot:compare <path-to-snapshot.json>', 'red');
                $out('The file is a snapshot taken on the SOURCE server (php bin/console snapshot).', 'yellow');
                exit(1);
            }
            $r = $svc->compareToCurrent($before);
            $out('Comparing source snapshot -> current database...', 'cyan');
            foreach ($r['dropped'] as $d) {
                $out("  [DATA LOSS] {$d['table']}: {$d['before']} -> {$d['after']}", 'red');
            }
            foreach ($r['missing'] as $m) {
                $out("  [MISSING TABLE] {$m}", 'red');
            }
            foreach ($r['added'] as $a) {
                $out("  [grew] {$a['table']}: {$a['before']} -> {$a['after']}", 'yellow');
            }
            if ($r['safe']) {
                $out('SAFE: no records were lost. Migration integrity verified.', 'green');
            } else {
                $out('UNSAFE: record loss detected. DO NOT switch production traffic. Investigate before proceeding.', 'red');
                exit(1);
            }
            break;

        case 'install:status':
            $st = (new \App\Services\InstallService())->state();
            $out('Installation status', 'cyan');
            $out('  DB reachable        : ' . ($st['db_reachable'] ? 'yes' : 'NO'), $st['db_reachable'] ? 'green' : 'red');
            $out('  State               : ' . ($st['installed'] ? 'EXISTING installation (data present)' : 'FRESH (no users yet)'), $st['installed'] ? 'green' : 'yellow');
            $out('  Users               : ' . $st['users']);
            $out('  Tables              : ' . $st['tables']);
            $out('  Migrations applied  : ' . $st['migrations_applied']);
            $out('  Migrations pending  : ' . $st['migrations_pending']);
            break;

        case 'install':
            // Deployment-safe install. Detects fresh vs existing so a redeploy
            // can never reseed or reset a live database.
            $installer = new \App\Services\InstallService();
            if ($installer->isInstalled()) {
                $out('Existing installation detected — production data is preserved.', 'yellow');
                $out('Skipping seed/admin creation. Applying pending migrations only (safe).', 'yellow');
                $ran = (new Migrator())->migrate();
                $out($ran ? 'Pending migrations applied.' : 'Database already up to date. Nothing changed.', 'green');
                $out('Tip: use "php bin/console upgrade" for a backup-first production upgrade.', 'cyan');
                break;
            }
            $out('Fresh installation detected. Running migrations...', 'cyan');
            (new Migrator())->migrate();
            $out('Seeding baseline data...', 'cyan');
            (new DatabaseSeeder())->run();
            $out('Installation complete. Default login: superadmin@school.test / Password123!', 'green');
            break;

        case 'admin:recover':
            // Authorized local recovery only. No web endpoint exists, so
            // deleting the installer lock can never expose an admin takeover.
            $recovery = new \App\Services\AdminRecoveryService();
            $email = trim((string) ($option('email') ?? ''));

            if ($email === '') {
                $out('Super administrator recovery', 'cyan');
                $admins = $recovery->superAdmins();
                if ($admins === []) {
                    $out('No super administrator accounts were found.', 'yellow');
                } else {
                    $out('Current super administrators:', 'cyan');
                    foreach ($admins as $admin) {
                        $state = ($admin['deleted_at'] ?? null) !== null ? 'deleted' : ((int) ($admin['is_active'] ?? 0) === 1 ? 'active' : 'inactive');
                        $out(sprintf('  #%d  %s  <%s>  username=%s  [%s]',
                            (int) $admin['id'],
                            (string) $admin['name'],
                            (string) $admin['email'],
                            (string) ($admin['username'] ?? '—'),
                            $state
                        ));
                    }
                }
                $out('');
                $out('Usage: php bin/console admin:recover --email=admin@example.com [options]', 'yellow');
                $out('  --password=...   New password (prompted securely when omitted)');
                $out('  --name="..."     Display name (used when creating)');
                $out('  --username=...   Preferred username (used when creating)');
                $out('  --create         Create the account if the email does not exist');
                $out('  --force          Skip the interactive RECOVER confirmation');
                $out('Existing users and all school data are preserved. Only the selected admin is reset.');
                break;
            }

            if (!$flag('force') && !$flag('yes')) {
                fwrite(STDOUT, 'Type RECOVER to reset the administrator password: ');
                $answer = trim((string) fgets(STDIN));
                if (strtoupper($answer) !== 'RECOVER') {
                    $out('Aborted. No changes were made.', 'yellow');
                    exit(1);
                }
            }

            $password = (string) ($option('password') ?? '');
            $generated = false;
            if ($password === '') {
                $password = $readHidden('New administrator password (leave blank to generate): ');
                if ($password === '') {
                    $password = bin2hex(random_bytes(9));
                    $generated = true;
                }
            }

            try {
                $result = $recovery->resetOrCreate(
                    $email,
                    $password,
                    $option('name'),
                    $flag('create'),
                    $option('username'),
                    'cli'
                );
            } catch (\InvalidArgumentException | \DomainException $e) {
                $out('Recovery failed: ' . $e->getMessage(), 'red');
                exit(1);
            }

            $out($result['created'] ? 'Super administrator created and activated.' : 'Super administrator password reset.', 'green');
            $out('  User ID : ' . $result['id']);
            $out('  Name    : ' . $result['name']);
            $out('  Email   : ' . $result['email']);
            $out('  Username: ' . $result['username']);
            if ($generated) {
                $out('  One-time password: ' . $password, 'yellow');
                $out('  Store this password now; it will not be shown again.', 'yellow');
            }
            $out('Remember-me tokens for this account were revoked. Existing browser sessions expire normally.', 'cyan');
            break;

        case 'db:info':
        case 'db:status':
            $info = (new \App\Services\DatabasePortabilityService())->getInfo();
            $out('=== Database Information ===', 'cyan');
            $out('Driver: ' . $info['driver']);
            $out('Status: ' . $info['status']);
            if (!empty($info['version'])) $out('Version: ' . substr((string)$info['version'], 0, 100));
            if (!empty($info['database'])) $out('Database: ' . $info['database']);
            $out('Migrations: ' . ($info['migrations_applied'] ?? 0) . ' applied, ' . ($info['migrations_pending'] ?? 0) . ' pending');
            if (!empty($info['pending_list'])) {
                $out('Pending: ' . implode(', ', $info['pending_list']), 'yellow');
            }
            break;

        case 'db:backup':
            $out('Creating database backup...', 'cyan');
            $backup = (new \App\Services\DatabaseBackupService())->create($option('label'));
            if ($backup) {
                $out('Backup created: ' . $backup, 'green');
            } else {
                $out('Backup failed or not available.', 'red');
                exit(1);
            }
            break;

        case 'db:backups':
            $list = (new \App\Services\DatabaseBackupService())->list();
            $out('=== Database Backups ===', 'cyan');
            if (empty($list)) {
                $out('No backups found.', 'yellow');
            } else {
                foreach ($list as $b) {
                    $out(sprintf('  %s (%s bytes) - %s', $b['name'], $b['size'], $b['date']));
                }
            }
            break;

        case 'db:drivers':
            $test = (new \App\Services\DatabasePortabilityService())->testAllDrivers();
            $out('=== Database Drivers Status ===', 'cyan');
            foreach ($test as $d => $info) {
                $ext = !empty($info['pdo_extension']) ? '[EXT OK]' : '[EXT MISSING]';
                $conf = !empty($info['configured']) ? '[CONFIGURED]' : '[NOT CONFIGURED]';
                $out(sprintf('  %s: %s %s', $d, $ext, $conf));
            }
            break;

        case 'help':
        default:
            $out('Unknown command: ' . $command, 'red');
            $out('Run php bin/console for usage.');
            exit(1);
    }
} catch (\Throwable $e) {
    $out('Error: ' . $e->getMessage(), 'red');
    if ((bool) \Core\Config\Config::get('app.debug')) {
        $out($e->getFile() . ':' . $e->getLine());
        $out($e->getTraceAsString());
    }
    exit(1);
}

exit(0);
